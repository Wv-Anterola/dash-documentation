{
  "name": "dash-documentation",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation and project history for Dash, a hypermedia system built at Brown University.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "astro check",
    "visuals": "node scripts/build-visual-posters.mjs && node scripts/build-page-visual-registry.mjs",
    "audit:branches": "node scripts/build-branch-audit.mjs",
    "audit:source": "node --expose-gc scripts/build-source-reference.mjs",
    "audit:symbols": "node scripts/build-exported-symbol-reference.mjs",
    "audit:http": "node scripts/build-http-route-reference.mjs",
    "audit:documents": "node scripts/build-document-type-reference.mjs",
    "audit:fields": "node scripts/build-field-type-reference.mjs",
    "audit:scripting": "node scripts/build-scripting-reference.mjs",
    "audit:controls": "node scripts/build-interface-control-reference.mjs",
    "audit:menus": "node --max-old-space-size=8000 scripts/build-context-menu-reference.mjs",
    "audit:keys": "node --max-old-space-size=8000 scripts/build-keyboard-shortcut-reference.mjs",
    "audit:projects": "node --max-old-space-size=8000 scripts/build-project-control-reference.mjs",
    "audit:tasks": "node --max-old-space-size=8000 scripts/build-task-route-reference.mjs",
    "audit:destinations": "node --max-old-space-size=8000 scripts/build-open-destination-reference.mjs",
    "audit:inapp": "node --max-old-space-size=8000 scripts/build-inapp-link-reference.mjs",
    "audit:coverage-report": "node scripts/build-coverage-report.mjs",
    "audit:scripting-usage": "node scripts/build-scripting-usage.mjs",
    "audit:pipeline": "node scripts/build-pipeline-map.mjs",
    "audit:typedoc": "node scripts/build-typedoc-reference.mjs",
    "audit:all": "npm run audit:branches && npm run audit:source && npm run audit:symbols && npm run audit:http && npm run audit:documents && npm run audit:fields && npm run audit:scripting && npm run audit:controls && npm run audit:menus && npm run audit:keys && npm run audit:projects && npm run audit:destinations && npm run audit:inapp && npm run audit:tasks && npm run audit:scripting-usage && npm run audit:coverage-report && npm run audit:typedoc && npm run audit:pipeline",
    "coverage": "node scripts/check-capability-coverage.mjs",
    "quality": "node scripts/check-documentation-quality.mjs",
    "encoding": "node scripts/check-encoding.mjs",
    "links": "node scripts/check-links.mjs",
    "links:external": "node scripts/check-external-links.mjs",
    "endpoints": "node scripts/check-machine-endpoints.mjs",
    "accessibility": "node scripts/check-accessibility.mjs",
    "budget": "node scripts/check-performance-budget.mjs",
    "preflight": "npm test && npm run encoding && npm run coverage && npm run quality",
    "verify": "npm run preflight && npm run check && npm run build && npm run links && npm run endpoints && npm run accessibility && npm run budget && npm run test:e2e",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/starlight": "^0.41.4",
    "astro": "^7.1.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.61.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.3"
  }
}
