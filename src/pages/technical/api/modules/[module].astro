---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SourceSymbolDetails from '../../../../components/SourceSymbolDetails.astro';
import { moduleSlug, reference, siteHref, sourceSymbolAnchors } from '../../../../data/sourceReference';
import { overlayForSymbol } from '../../../../data/symbolOverlays';

export function getStaticPaths() {
  return reference.modules.map((module) => ({
    params: { module: moduleSlug(module.path) },
    props: { module },
  }));
}

type Module = (typeof reference.modules)[number];
interface Props {
  module: Module;
}

const { module } = Astro.props;
const exported = module.symbols.filter((symbol) => symbol.exported);
const internal = module.symbols.filter((symbol) => !symbol.exported);
const documented = module.symbols.filter((symbol) => symbol.documentation || overlayForSymbol(symbol.id)).length;
const symbolAnchors = sourceSymbolAnchors(module);
const callsBySource = new Map<string, Set<string>>();
const referencesByTarget = new Map<string, Set<string>>();

for (const call of module.calls) {
  const calls = callsBySource.get(call.from) ?? new Set<string>();
  calls.add(call.to);
  callsBySource.set(call.from, calls);

  const references = referencesByTarget.get(call.to) ?? new Set<string>();
  references.add(call.from);
  referencesByTarget.set(call.to, references);
}

const callNames = (symbol: Module['symbols'][number]) =>
  [...new Set([
    ...(callsBySource.get(symbol.name) ?? []),
    ...(callsBySource.get(symbol.qualifiedName) ?? []),
  ])].sort();

const callerNames = (symbol: Module['symbols'][number]) =>
  [...new Set([
    ...(referencesByTarget.get(symbol.name) ?? []),
    ...(referencesByTarget.get(symbol.qualifiedName) ?? []),
  ])].sort();
const apiHref = siteHref('/technical/api/');
const exportedSymbolsHref = siteHref('/technical/exported-symbols/');
const snapshotHref = siteHref('/reference/implementation-snapshot/');
---

<StarlightPage
  frontmatter={{
    title: module.path,
    description: `${module.symbols.length} source-generated declarations, imports, and syntax-resolved calls.`,
  }}
>
  <p class="source-breadcrumb">
    <a href={apiHref}>API reference</a> /
    <a href={exportedSymbolsHref}>exported symbols</a> / module
  </p>

  <div class="audit-summary" aria-label="Module totals">
    <div><strong>{module.symbols.length}</strong><span>named declarations</span></div>
    <div><strong>{exported.length}</strong><span>exported declarations</span></div>
    <div><strong>{documented}</strong><span>documented contracts</span></div>
    <div><strong>{module.calls.length}</strong><span>syntax-resolved calls</span></div>
  </div>

  <dl class="source-module-meta">
    <div><dt>Language parser</dt><dd>{module.language}</dd></div>
    <div><dt>Imports</dt><dd>{module.imports.length ? module.imports.join(', ') : 'None recorded'}</dd></div>
    <div><dt>Source version</dt><dd><a href={snapshotHref}>Reproducible snapshot</a></dd></div>
  </dl>

  {module.parserErrors.length > 0 && (
    <div class="source-warning">
      <strong>Parser failure:</strong> this module is incomplete and fails source-reference validation.
    </div>
  )}

  <h2 id="exports">Exported API</h2>
  {exported.length === 0 ? <p>This module has no exported declarations.</p> : (
    <div class="symbol-reference">
      {exported.map((symbol) => (
        <SourceSymbolDetails
          symbol={symbol}
          overlay={overlayForSymbol(symbol.id)}
          anchor={symbolAnchors.get(symbol) ?? moduleSlug(symbol.qualifiedName)}
          calls={callNames(symbol)}
          callers={callerNames(symbol)}
        />
      ))}
    </div>
  )}

  <h2 id="internal-symbols">Internal symbol index</h2>
  <p>
    Internal declarations remain searchable and source-linked. Inclusion here
    does not make them a supported extension contract. Call lists are direct,
    syntax-resolved evidence within this module; they are not a complete
    cross-module runtime graph.
  </p>
  <div class="symbol-reference">
    {internal.map((symbol) => (
      <SourceSymbolDetails
        symbol={symbol}
        overlay={overlayForSymbol(symbol.id)}
        anchor={symbolAnchors.get(symbol) ?? moduleSlug(symbol.qualifiedName)}
        calls={callNames(symbol)}
        callers={callerNames(symbol)}
      />
    ))}
  </div>

  <script>
    const revealTarget = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      if (!id) return;
      const target = document.getElementById(id);
      if (target instanceof HTMLDetailsElement) target.open = true;
    };

    revealTarget();
    window.addEventListener('hashchange', revealTarget);
  </script>
</StarlightPage>
