---
/**
 * The project index: a dense table, filterable by cohort, area, and status.
 *
 * Progressive enhancement. The full table renders without JavaScript, which is
 * the useful default; the script only hides rows already in the page.
 */
import {
  projects,
  cohorts,
  statuses,
  areas,
  cohortOf,
  projectHref,
  projectSlug,
  withBase,
} from '../data/dash';
import { capabilitiesForProject } from '../data/capabilities';
import { visualForProject } from '../data/visuals';
import StatusBadge from './StatusBadge.astro';
import VisualEvidence from './VisualEvidence.astro';

const allAreas = areas();
---

<div class="filter-bar">
  <div>
    <label class="dash-label" for="f-cohort">Cohort</label>
    <select id="f-cohort">
      <option value="">Any</option>
      {cohorts.map((c) => <option value={c.id}>{c.title}</option>)}
    </select>
  </div>
  <div>
    <label class="dash-label" for="f-area">System area</label>
    <select id="f-area">
      <option value="">Any</option>
      {allAreas.map((a) => <option value={a}>{a}</option>)}
    </select>
  </div>
  <div>
    <label class="dash-label" for="f-status">Status</label>
    <select id="f-status">
      <option value="">Any</option>
      {statuses.map((s) => <option value={s.key}>{s.label}</option>)}
    </select>
  </div>
</div>

<p class="filter-count" id="f-count" role="status"></p>

<div class="project-atlas" id="project-atlas">
  {
    projects.map((p) => (
      <article
        class="project-atlas__card"
        data-cohort={p.cohort}
        data-area={p.area}
        data-status={p.status}
      >
        <VisualEvidence evidence={visualForProject(p.title)} compact />
        <div class="project-atlas__body">
          <h3><a href={withBase(`/research/projects/${projectSlug(p.title)}/`)}>{p.title}</a></h3>
          <p class="project-atlas__meta">
            <StatusBadge status={p.status} />
            <span>{cohortOf(p.cohort).short}</span>
            <span>{p.area}</span>
          </p>
          {p.people && <p class="project-atlas__people">{p.people.join(', ')}</p>}
          <p class="project-atlas__people"><a href={projectHref(p)}>Cohort narrative and full workflow</a></p>
          <p class="project-atlas__capabilities">
            <span class="dash-label">Product capabilities</span>
            {capabilitiesForProject(p.title).length > 0
              ? capabilitiesForProject(p.title).map((capability, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={withBase(capability.docs)}>{capability.title}</a>
                  </>
                ))
              : <span> No canonical capability mapping; see project status.</span>}
          </p>
        </div>
      </article>
    ))
  }
</div>

<script>
  const atlas = document.getElementById('project-atlas');
  const count = document.getElementById('f-count');
  const selects = ['f-cohort', 'f-area', 'f-status'].map(
    (id) => document.getElementById(id) as HTMLSelectElement | null
  );

  if (atlas && count && selects.every(Boolean)) {
    const cards = Array.from(atlas.querySelectorAll<HTMLElement>('.project-atlas__card'));
    const keys = ['cohort', 'area', 'status'] as const;

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const ok = selects.every((sel, i) => !sel!.value || card.dataset[keys[i]] === sel!.value);
        card.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent =
        shown === cards.length
          ? `Showing all ${cards.length} projects.`
          : `Showing ${shown} of ${cards.length} projects.`;
    };

    for (const sel of selects) sel!.addEventListener('change', apply);
    apply();
  }
</script>
