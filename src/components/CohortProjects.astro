---
/**
 * The case studies for one cohort.
 *
 * Each study shows its title, one line of metadata, and its research or design
 * problem. Method, contribution, integration, evidence, and implementation sit
 * in a structured details panel underneath.
 *
 * The earlier version rendered eight uppercase-labelled fields per project.
 * Every project record populates every field, so nothing ever varied: thirteen
 * projects on the 2026 page produced 104 uppercase labels and made forty
 * different pieces of work look like forty copies of one form.
 *
 * The panel is collapsed by default but never hidden:
 *
 * - `projectHref()` links from concept pages, the project index, and inline
 *   project references all target `#<slug>`, so the script below opens the
 *   panel a visitor was actually sent to.
 * - Pagefind indexes the panel because it is in the DOM either way, so evidence
 *   text still turns up in search.
 * - Print styles in dash.css expand every panel.
 */
import {
  projectsInCohort,
  conceptOf,
  conceptHref,
  projectSlug,
  withBase,
  type CohortId,
} from '../data/dash';
import { capabilitiesForProject } from '../data/capabilities';
import { visualForProject } from '../data/visuals';
import StatusBadge from './StatusBadge.astro';
import VisualEvidence from './VisualEvidence.astro';
import ProjectWorkflow from './ProjectWorkflow.astro';

interface Props {
  cohort: CohortId;
}

const { cohort } = Astro.props;
const rows = projectsInCohort(cohort);

/** Inline code spans written as markdown inside the data file. */
const md = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>');
---

{
  rows.map((p) => {
    const slug = projectSlug(p.title);
    return (
      <section class="case-study" id={`study-${slug}`}>
        <h3 id={slug}>{p.title}</h3>

        <p class="case-study__meta">
          <StatusBadge status={p.status} />
          <span>{p.area}</span>
          {p.people && <span>{p.people.join(', ')}</span>}
          {p.peopleUnresolved && <span>Contributor {p.peopleUnresolved}</span>}
        </p>

        {p.problem && <p class="case-study__lead" set:html={md(p.problem)} />}

        <VisualEvidence evidence={visualForProject(p.title)} />

        <details class="case-study__detail">
          <summary>Research record and implementation</summary>
          <div class="case-study__body">
            <dl>
              {p.approach && (
                <>
                  <dt class="dash-label">Method or approach</dt>
                  <dd set:html={md(p.approach)} />
                </>
              )}
              {p.contribution && (
                <>
                  <dt class="dash-label">System contribution</dt>
                  <dd set:html={md(p.contribution)} />
                </>
              )}
              {p.relation && (
                <>
                  <dt class="dash-label">Relationship to Dash</dt>
                  <dd set:html={md(p.relation)} />
                </>
              )}
              {p.outcome && (
                <>
                  <dt class="dash-label">Current result</dt>
                  <dd set:html={md(p.outcome)} />
                </>
              )}
              {p.evidence && (
                <>
                  <dt class="dash-label">Evidence basis</dt>
                  <dd set:html={md(p.evidence)} />
                </>
              )}
              {(p.tech || p.code) && (
                <>
                  <dt class="dash-label">Implementation</dt>
                  <dd>
                    {p.tech && <span>{p.tech.join(', ')}</span>}
                    {p.tech && p.code && <span aria-hidden="true"> · </span>}
                    {p.code && <span set:html={md(p.code)} />}
                  </dd>
                </>
              )}
              {capabilitiesForProject(p.title).length > 0 && (
                <>
                  <dt class="dash-label">Product capabilities</dt>
                  <dd>
                    {capabilitiesForProject(p.title).map((capability, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={withBase(capability.docs)}>{capability.title}</a>
                      </>
                    ))}
                  </dd>
                </>
              )}
              {p.concepts.length > 0 && (
                <>
                  <dt class="dash-label">Background reading</dt>
                  <dd>
                    {p.concepts.map((cid, i) => {
                      const c = conceptOf(cid);
                      return (
                        <>
                          {i > 0 && ', '}
                          <a href={conceptHref(c)}>{c.title}</a>
                        </>
                      );
                    })}
                  </dd>
                </>
              )}
            </dl>

            <ProjectWorkflow project={p} />
          </div>
        </details>
      </section>
    );
  })
}

<script>
  // Open the case study a visitor was linked to. Every project reference on the
  // site resolves to `#<slug>`, so without this a reader following "see how the
  // graph view connects to the layout engine" would land on a collapsed panel.
  const openTarget = () => {
    const hash = decodeURIComponent(location.hash.slice(1));
    if (!hash) return;
    const heading = document.getElementById(hash);
    const study = heading?.closest('.case-study');
    const detail = study?.querySelector('details');
    if (!detail || detail.open) return;
    detail.open = true;
    // The panel expanding moves the heading, so put it back under the cursor.
    heading!.scrollIntoView({ block: 'start' });
  };

  openTarget();
  window.addEventListener('hashchange', openTarget);
</script>
