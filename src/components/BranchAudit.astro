---
import reference from '../data/generated/semantic-branches.json';
import { branchRecordHref } from '../data/branchEvidence';

const current = reference.branches.filter((branch) => branch.containedInBaseline);
const branchOnly = reference.branches.filter((branch) => !branch.containedInBaseline);
const branchAnchor = (branch: { displayName: string }) =>
  `branch-${branch.displayName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<div class="audit-summary" aria-label="Branch audit totals">
  <div><strong>{reference.methodology.branchCount}</strong><span>local and origin refs</span></div>
  <div><strong>{reference.methodology.reachableCommits.toLocaleString()}</strong><span>reachable commits</span></div>
  <div><strong>{reference.methodology.reachableBlobs.toLocaleString()}</strong><span>classified reachable blobs</span></div>
  <div><strong>{reference.methodology.symbolCount.toLocaleString()}</strong><span>canonical named symbols</span></div>
</div>

<div class="audit-pipeline" role="img" aria-label="How the semantic source audit works">
  <div><span>1</span><strong>List every branch tip</strong><small>origin and local refs</small></div>
  <b aria-hidden="true">→</b>
  <div><span>2</span><strong>Walk reachable history</strong><small>{reference.methodology.reachableCommits.toLocaleString()} commits</small></div>
  <b aria-hidden="true">→</b>
  <div><span>3</span><strong>Parse each source blob</strong><small>TypeScript compiler + Python AST</small></div>
  <b aria-hidden="true">→</b>
  <div><span>4</span><strong>Compare symbols</strong><small>added, changed, removed, unreachable</small></div>
</div>

<div class="filter-bar branch-audit__filters">
  <div>
    <label class="dash-label" for="branch-query">Find a branch, file, symbol, or feature</label>
    <input id="branch-query" type="search" placeholder="Try mapbox, agent, trails, or dataviz…" />
  </div>
  <div>
    <label class="dash-label" for="branch-state">Relationship to master</label>
    <select id="branch-state">
      <option value="">All {reference.branches.length}</option>
      <option value="current">Contained in master ({current.length})</option>
      <option value="branch-only">Branch-only ({branchOnly.length})</option>
    </select>
  </div>
</div>

<p class="filter-count" id="branch-count" role="status"></p>

<div class="branch-audit" id="branch-audit">
  {reference.branches.map((branch) => {
    const semanticRowCount =
      branch.semanticDelta.added.length +
      branch.semanticDelta.changed.length +
      branch.semanticDelta.removed.length;
    const changedFileCount =
      branch.fileDelta.added + branch.fileDelta.changed + branch.fileDelta.removed + branch.fileDelta.renamed;
    const searchable = `${branch.shortName} ${branch.displayName}`.toLowerCase();
    return (
      <details
        id={branchAnchor(branch)}
        class="branch-audit__row"
        data-state={branch.containedInBaseline ? 'current' : 'branch-only'}
        data-search={searchable}
      >
        <summary>
          <span>
            <code>{branch.displayName}</code>
            <small>{semanticRowCount} changed declarations · {changedFileCount} changed files</small>
          </span>
          <span class:list={[
            'branch-audit__state',
            branch.containedInBaseline && 'branch-audit__state--current',
          ]}>
            {branch.containedInBaseline ? 'in master' : 'branch-only'}
          </span>
        </summary>
        <div class="branch-audit__body">
          <dl>
            <div><dt>Last source update</dt><dd>{branch.authoredAt.slice(0, 10)}</dd></div>
            <div><dt>Compared with master</dt><dd>{branch.aheadOfBaseline} ahead · {branch.behindBaseline} behind</dd></div>
            <div><dt>File delta</dt><dd>{branch.fileDelta.added} added · {branch.fileDelta.changed} changed · {branch.fileDelta.removed} removed · {branch.fileDelta.renamed} renamed</dd></div>
            <div><dt>Symbol delta</dt><dd>{branch.semanticDelta.added.length} added · {branch.semanticDelta.changed.length} changed · {branch.semanticDelta.removed.length} removed</dd></div>
            <div><dt>Unreachable paths</dt><dd>{branch.semanticDelta.unreachable.length} absent from this branch tip</dd></div>
          </dl>
          <p><a href={branchRecordHref(branch.fullName)}>Open the complete implementation record</a></p>
        </div>
      </details>
    );
  })}
</div>

<details class="audit-digest">
  <summary>Archive reproducibility metadata</summary>
  <p>
    Digest: <code>{reference.methodology.digest}</code><br />
    Baseline revision: <code>{reference.repository.baselineTip}</code> · generated {reference.generatedAt.slice(0, 10)}
  </p>
</details>

<script>
  const query = document.getElementById('branch-query') as HTMLInputElement | null;
  const state = document.getElementById('branch-state') as HTMLSelectElement | null;
  const count = document.getElementById('branch-count');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.branch-audit__row'));

  const apply = () => {
    const needle = query?.value.trim().toLowerCase() ?? '';
    const selectedState = state?.value ?? '';
    let shown = 0;
    for (const row of rows) {
      const matchesText = !needle || row.dataset.search?.includes(needle);
      const matchesState = !selectedState || row.dataset.state === selectedState;
      row.hidden = !(matchesText && matchesState);
      if (!row.hidden) shown++;
    }
    if (count) count.textContent = `Showing ${shown} of ${rows.length} branches.`;
  };

  query?.addEventListener('input', apply);
  state?.addEventListener('change', apply);
  apply();

  const openHash = () => {
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (target instanceof HTMLDetailsElement) target.open = true;
  };
  openHash();
  window.addEventListener('hashchange', openHash);
</script>
