---
import { type Project } from '../data/dash';
import { workflowForProject } from '../data/projectWorkflows';
import { branchRecordHref, branchesForProject } from '../data/branchEvidence';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const steps = workflowForProject(project);
const branches = branchesForProject(project);
---

<section class="project-workflow" aria-label={`Complete workflow for ${project.title}`}>
  <div class="project-workflow__heading">
    <div>
      <p class="dash-label">End-to-end behavior</p>
      <h4>Interaction and implementation workflow</h4>
    </div>
    <span>{steps.length} steps</span>
  </div>

  <ol class="project-workflow__steps">
    {steps.map((step) => (
      <li>
        <p class="project-workflow__eyebrow">{step.eyebrow}</p>
        <h5>{step.title}</h5>
        <p>{step.explanation}</p>
        <details>
          <summary>Implementation details</summary>
          <p>{step.technical}</p>
        </details>
      </li>
    ))}
  </ol>

  <details class="project-workflow__branches">
    <summary>Implementation provenance</summary>
    {branches.length > 0 ? (
      <ul>
        {branches.map((branch) => (
          <li>
            <a href={branchRecordHref(branch.fullName)}>
              <code>{branch.displayName}</code>
            </a>
            <span>
              {branch.containedInBaseline
                ? 'included in the current application'
                : `branch implementation · ${branch.changedSourceFileCount} changed source files`}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p>
        No branch identifier is recorded for this project. The source paths and status
        evidence above are the available implementation record.
      </p>
    )}
  </details>
</section>
