---
import { withBase, type Project } from '../data/dash';
import { workflowForProject } from '../data/projectWorkflows';
import { branchAnchor, branchesForProject } from '../data/branchEvidence';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const steps = workflowForProject(project);
const branches = branchesForProject(project);
---

<section class="project-workflow" aria-label={`Complete workflow for ${project.title}`}>
  <div class="project-workflow__heading">
    <div>
      <p class="dash-label">Whole workflow</p>
      <h4>From first click to useful result</h4>
    </div>
    <span>{steps.length} steps</span>
  </div>

  <ol class="project-workflow__steps">
    {steps.map((step) => (
      <li>
        <p class="project-workflow__eyebrow">{step.eyebrow}</p>
        <h5>{step.title}</h5>
        <p>{step.explanation}</p>
        <details>
          <summary>What the code does</summary>
          <p><code>{step.technical}</code></p>
        </details>
      </li>
    ))}
  </ol>

  <div class="project-workflow__branches">
    <strong>Code checked for this project</strong>
    {branches.length > 0 ? (
      <ul>
        {branches.map((branch) => (
          <li>
            <a href={`${withBase('/reference/branch-audit/')}#${branchAnchor(branch)}`}>
              <code>{branch.displayName}</code>
            </a>
            <span>{branch.tip.slice(0, 10)}</span>
            <span>
              {branch.containedInBaseline
                ? 'contained in current master'
                : `${branch.aheadOfBaseline} commits ahead · ${branch.changedSourceFileCount} changed source files`}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p>
        No surviving branch name is written in the project record. The source paths and
        status evidence above are the available implementation trail.
      </p>
    )}
  </div>
</section>
