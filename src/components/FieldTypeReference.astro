---
import reference from '../data/generated/field-types.json';

const registrations = reference.registrations as any[];
const categoryLabels: Record<string, string> = {
  collection: 'Collection',
  content: 'Content',
  executable: 'Executable',
  identity: 'Identity',
  interaction: 'Interaction',
  media: 'Media',
  reference: 'Reference',
  scalar: 'Scalar',
};
const conversionLabels: Record<string, string> = {
  Copy: 'copy',
  ToValue: 'runtime value',
  ToJavascriptString: 'JavaScript text',
  ToScriptString: 'Dash script text',
  ToString: 'plain string',
  ToPlainText: 'plain text',
};
const anchorFor = (tag: string) => `wire-type-${tag.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section class="field-type-reference" data-field-type-reference>
  <div class="field-type-summary" aria-label="Field runtime inventory summary">
    <div><strong>{reference.summary.primitiveTypes}</strong><span>primitive kinds</span></div>
    <div><strong>{reference.summary.registeredTags}</strong><span>registered wire tags</span></div>
    <div><strong>{reference.summary.categories}</strong><span>runtime families</span></div>
    <div><strong>{reference.summary.repairHooks}</strong><span>hydration repair hooks</span></div>
    <div><strong>{reference.summary.scriptingGlobals}</strong><span>script-visible types</span></div>
  </div>

  <div class="field-primitives" aria-label="Primitive field types">
    {reference.primitives.map((primitive) => (
      <article>
        <code>{primitive.type}</code>
        <strong>{primitive.storedAs}</strong>
        <span>{primitive.behavior}</span>
      </article>
    ))}
  </div>

  <div class="field-type-filters" aria-label="Filter registered field types">
    <label for="field-type-query">
      Find a tag, class, stored member, behavior, or purpose
      <input id="field-type-query" type="search" placeholder="Try proxy, URL, script, or fields" data-field-type-query />
    </label>
    <label for="field-type-category">
      Runtime family
      <select id="field-type-category" data-field-type-category>
        <option value="">All families</option>
        {reference.categories.map((category) => <option value={category}>{categoryLabels[category] ?? category}</option>)}
      </select>
    </label>
    <label for="field-type-repair">
      Hydration repair
      <select id="field-type-repair" data-field-type-repair>
        <option value="">All hydration paths</option>
        <option value="yes">Has repair hook</option>
        <option value="no">Data-only hydration</option>
      </select>
    </label>
    <label for="field-type-script">
      Script visibility
      <select id="field-type-script" data-field-type-script>
        <option value="">All visibility</option>
        <option value="yes">Available to scripts</option>
        <option value="no">Runtime-internal</option>
      </select>
    </label>
  </div>

  <p class="field-type-count" aria-live="polite" data-field-type-count>{registrations.length} registered types shown</p>

  <div class="field-type-list">
    {registrations.map((entry) => {
      const searchText = [
        entry.tag,
        entry.className,
        entry.label,
        entry.category,
        entry.purpose,
        entry.hydration,
        entry.copy,
        entry.base,
        ...entry.baseChain,
        ...entry.storedMembers.flatMap((member: any) => [member.name, member.type, member.schema]),
        ...entry.conversions.flatMap((method: any) => [method.name, conversionLabels[method.name]]),
        ...entry.mutationMethods.map((method: any) => method.name),
      ].filter(Boolean).join(' ').toLowerCase();
      const repair = Boolean(entry.registration.repairHook);
      return (
        <details
          id={anchorFor(entry.tag)}
          class="field-type-card"
          data-field-type-row
          data-category={entry.category}
          data-repair={repair ? 'yes' : 'no'}
          data-script={entry.scriptingGlobal ? 'yes' : 'no'}
          data-search={searchText}
        >
          <summary>
            <span class="field-type-identity">
              <code>{entry.tag}</code>
              <span>{entry.label}</span>
            </span>
            <span class="field-type-class"><small>hydrates as</small><code>{entry.className}</code></span>
            <span class={`field-type-badge field-type-badge--${entry.category}`}>{categoryLabels[entry.category] ?? entry.category}</span>
            <span class="field-type-chevron" aria-hidden="true">⌄</span>
          </summary>

          <div class="field-type-detail">
            <div>
              <h3>Meaning and ownership</h3>
              <p>{entry.purpose}</p>
              <dl class="field-type-facts">
                <div><dt>Direct base</dt><dd><code>{entry.base ?? 'none'}</code></dd></div>
                <div><dt>Full ancestry</dt><dd>{entry.baseChain.length ? entry.baseChain.map((base: string) => <code>{base}</code>).reduce((all: any[], item: any, index: number) => [...all, index ? ' → ' : '', item], []) : 'none'}</dd></div>
                <div><dt>Script global</dt><dd>{entry.scriptingGlobal ? 'yes' : 'no'}</dd></div>
              </dl>
              <p><a href={entry.registration.source.url}>wire registration, line {entry.registration.source.line}</a></p>
            </div>

            <div>
              <h3>Stored members</h3>
              <div class="field-member-list">
                {entry.storedMembers.map((member: any) => (
                  <article>
                    <p><a href={member.source.url}><code>{member.name}</code></a> <span>{member.type}</span></p>
                    <code>{member.schema}</code>
                    {member.owner !== entry.className && <small>inherited from {member.owner}</small>}
                  </article>
                ))}
              </div>
            </div>

            <div>
              <h3>Hydration, mutation, and conversion</h3>
              <p>{entry.hydration}</p>
              {entry.registration.repairHook ? (
                <p class="field-type-note"><strong>Repair hook:</strong> <code>{entry.registration.repairHook}</code></p>
              ) : (
                <p class="field-type-note field-type-note--plain">No class-specific repair hook; declared serializr schemas restore the stored data.</p>
              )}
              {entry.registration.constructorArgs && <p><strong>Constructor fields:</strong> <code>{entry.registration.constructorArgs}</code></p>}
              <p><strong>Copy contract:</strong> {entry.copy}</p>
              <p><strong>Conversions:</strong>{' '}{entry.conversions.map((method: any, index: number) => <>{index ? ', ' : ''}<code>{conversionLabels[method.name] ?? method.name}</code>{method.owner !== entry.className ? ` (${method.owner})` : ''}</>)}</p>
              <p><strong>Explicit nested-change methods:</strong>{' '}{entry.mutationMethods.length ? entry.mutationMethods.map((method: any, index: number) => <>{index ? ', ' : ''}<code>{method.name}</code></>) : 'none declared on the effective class chain'}</p>
            </div>
          </div>
        </details>
      );
    })}
  </div>
</section>

<script>
  for (const root of document.querySelectorAll('[data-field-type-reference]')) {
    const query = root.querySelector<HTMLInputElement>('[data-field-type-query]');
    const category = root.querySelector<HTMLSelectElement>('[data-field-type-category]');
    const repair = root.querySelector<HTMLSelectElement>('[data-field-type-repair]');
    const script = root.querySelector<HTMLSelectElement>('[data-field-type-script]');
    const count = root.querySelector('[data-field-type-count]');
    const rows = [...root.querySelectorAll<HTMLDetailsElement>('[data-field-type-row]')];
    if (!query || !category || !repair || !script || !count) continue;
    const update = () => {
      const needle = query.value.trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const show =
          (!needle || row.dataset.search?.includes(needle)) &&
          (!category.value || row.dataset.category === category.value) &&
          (!repair.value || row.dataset.repair === repair.value) &&
          (!script.value || row.dataset.script === script.value);
        row.hidden = !show;
        if (show) visible++;
      }
      count.textContent = `${visible} registered type${visible === 1 ? '' : 's'} shown`;
    };
    query.addEventListener('input', update);
    category.addEventListener('change', update);
    repair.addEventListener('change', update);
    script.addEventListener('change', update);
  }
</script>

<style>
  .field-type-reference { container-type: inline-size; margin-block: 1.25rem 2rem; }
  .field-type-summary { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .65rem; margin-block: 1rem; }
  .field-type-summary div { border: 1px solid var(--sl-color-gray-5); border-radius: .65rem; padding: .8rem; background: var(--sl-color-gray-7); }
  .field-type-summary strong { display: block; color: var(--sl-color-accent-high); font-size: 1.45rem; line-height: 1; }
  .field-type-summary span { display: block; margin-top: .35rem; color: var(--sl-color-gray-2); font-size: .76rem; }
  .field-primitives { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .65rem; margin-block: 1rem 1.35rem; }
  .field-primitives article { display: grid; gap: .25rem; border-left: 3px solid var(--sl-color-accent); padding: .45rem .7rem; background: var(--sl-color-gray-7); }
  .field-primitives strong { font-size: .8rem; }
  .field-primitives span { color: var(--sl-color-gray-2); font-size: .72rem; }
  .field-type-filters { display: grid; grid-template-columns: minmax(15rem, 2fr) repeat(3, minmax(8.5rem, 1fr)); gap: .75rem; align-items: end; }
  .field-type-filters label { min-width: 0; color: var(--sl-color-gray-2); font-size: .78rem; font-weight: 650; }
  .field-type-filters :is(input, select) { width: 100%; min-width: 0; min-height: 2.6rem; margin-top: .3rem; border: 1px solid var(--sl-color-gray-4); border-radius: .5rem; padding: .5rem .65rem; background: var(--sl-color-bg); color: var(--sl-color-white); font: inherit; font-weight: 450; }
  .field-type-count { margin-block: .85rem; color: var(--sl-color-gray-2); font-size: .85rem; }
  .field-type-list { display: grid; gap: .55rem; }
  .field-type-card { scroll-margin-top: 7rem; overflow: clip; border: 1px solid var(--sl-color-gray-5); border-radius: .7rem; background: var(--sl-color-gray-7); }
  .field-type-card[open] { border-color: var(--sl-color-accent); background: var(--sl-color-bg); }
  .field-type-card summary { display: grid; grid-template-columns: minmax(10rem, 1.15fr) minmax(8rem, .8fr) minmax(7rem, .55fr) auto; gap: .8rem; align-items: center; padding: .8rem 1rem; cursor: pointer; list-style: none; }
  .field-type-card summary::-webkit-details-marker { display: none; }
  .field-type-card summary::marker { content: ''; font-size: 0; }
  .field-type-card summary::before { display: none !important; }
  .field-type-identity { display: grid; grid-template-columns: minmax(4rem, auto) 1fr; gap: .7rem; align-items: baseline; min-width: 0; }
  .field-type-identity > span { color: var(--sl-color-white); font-weight: 650; }
  .field-type-class { display: flex; gap: .45rem; align-items: baseline; min-width: 0; color: var(--sl-color-gray-2); }
  .field-type-class small { white-space: nowrap; }
  .field-type-class code { overflow-wrap: anywhere; }
  .field-type-badge { justify-self: start; border-radius: 999px; padding: .25rem .55rem; background: var(--sl-color-blue-low); color: var(--sl-color-blue-high); font-size: .7rem; font-weight: 750; }
  .field-type-badge--executable { background: var(--sl-color-purple-low); color: var(--sl-color-purple-high); }
  .field-type-badge--reference, .field-type-badge--identity { background: var(--sl-color-orange-low); color: var(--sl-color-orange-high); }
  .field-type-chevron { transition: transform .15s ease; }
  details[open] .field-type-chevron { transform: rotate(180deg); }
  .field-type-detail { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.05fr) minmax(0, 1.15fr); gap: 1rem; border-top: 1px solid var(--sl-color-gray-5); padding: 1rem; }
  .field-type-detail > div { min-width: 0; }
  .field-type-detail h3 { margin: 0 0 .65rem; font-size: .95rem; }
  .field-type-detail p { margin-block: .45rem; font-size: .8rem; }
  .field-type-facts { display: grid; gap: .35rem; margin: 0; font-size: .77rem; }
  .field-type-facts div { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: .45rem; }
  .field-type-facts dt { color: var(--sl-color-gray-2); font-weight: 700; }
  .field-type-facts dd { min-width: 0; margin: 0; overflow-wrap: anywhere; }
  .field-member-list { display: grid; gap: .45rem; }
  .field-member-list article { border: 1px solid var(--sl-color-gray-5); border-radius: .45rem; padding: .5rem; background: var(--sl-color-gray-7); }
  .field-member-list p { display: flex; justify-content: space-between; gap: .5rem; margin: 0 0 .25rem; }
  .field-member-list p span { color: var(--sl-color-gray-2); font-size: .7rem; text-align: right; overflow-wrap: anywhere; }
  .field-member-list article > code { display: block; white-space: normal; overflow-wrap: anywhere; color: var(--sl-color-gray-2); font-size: .67rem; }
  .field-member-list small { display: block; margin-top: .25rem; color: var(--sl-color-gray-3); font-size: .65rem; }
  .field-type-note { border-left: 3px solid var(--sl-color-orange); padding-left: .6rem; color: var(--sl-color-gray-2); overflow-wrap: anywhere; }
  .field-type-note--plain { border-color: var(--sl-color-gray-4); }
  @container (max-width: 800px) {
    .field-type-detail { grid-template-columns: 1fr; }
  }
  @container (max-width: 680px) {
    .field-type-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field-primitives { grid-template-columns: 1fr; }
    .field-type-filters { grid-template-columns: 1fr 1fr; }
    .field-type-filters label:first-child { grid-column: 1 / -1; }
  }
  @container (max-width: 540px) {
    .field-type-card summary { grid-template-columns: minmax(0, 1fr) auto; }
    .field-type-class, .field-type-badge { grid-column: 1; }
    .field-type-chevron { grid-column: 2; grid-row: 1 / span 3; }
  }
  @container (max-width: 430px) {
    .field-type-filters { grid-template-columns: 1fr; }
    .field-type-filters label:first-child { grid-column: auto; }
    .field-type-identity { grid-template-columns: 1fr; gap: .2rem; }
  }
  @container (max-width: 330px) {
    .field-type-summary { grid-template-columns: 1fr; }
  }
</style>
