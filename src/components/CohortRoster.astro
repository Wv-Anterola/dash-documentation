---
/**
 * The provisional student roster for one cohort.
 */
import { cohortOf, type CohortId } from '../data/dash';

interface Props {
  cohort: CohortId;
}

const { cohort } = Astro.props;
const c = cohortOf(cohort);
---

<ul class="roster">
  {c.roster.map((person) => <li>{person}</li>)}
</ul>

<p class="roster__note">
  Compiled from repository authorship records and the group's historical team
  lists. Contributors whose identities could not be verified are listed
  separately on the People page.
</p>
