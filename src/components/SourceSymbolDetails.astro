---
import type { SourceSymbol } from '../data/sourceReference';
import type { SymbolOverlay } from '../data/symbolOverlays';

interface Props {
  symbol: SourceSymbol;
  overlay?: SymbolOverlay;
  anchor: string;
  calls?: string[];
  callers?: string[];
}

const {
  symbol,
  overlay,
  anchor,
  calls = [],
  callers = [],
} = Astro.props;

const visibleCalls = calls.slice(0, 12);
const visibleCallers = callers.slice(0, 12);
---

<details id={anchor} data-source-symbol>
  <summary>
    <span>
      <code>{symbol.qualifiedName}</code>
      <small>{symbol.kind} · {symbol.visibility}</small>
    </span>
    <a href={symbol.sourceUrl}>source L{symbol.lineStart}–L{symbol.lineEnd}</a>
  </summary>
  <div>
    <pre><code>{symbol.signature}</code></pre>

    {symbol.documentation || overlay
      ? <>
          <p>{overlay?.summary || symbol.documentation}</p>
          {overlay && symbol.documentation && overlay.summary !== symbol.documentation && (
            <p class="source-authored-description">
              <strong>Source description:</strong> {symbol.documentation}
            </p>
          )}
          {overlay?.parameters && (
            <dl class="source-contract">
              {Object.entries(overlay.parameters).map(([name, description]) => (
                <div><dt><code>{name}</code></dt><dd>{description}</dd></div>
              ))}
            </dl>
          )}
          {overlay?.returns && <p><strong>Returns:</strong> {overlay.returns}</p>}
          {overlay?.preconditions?.map((condition) => <p><strong>Precondition:</strong> {condition}</p>)}
          {overlay?.postconditions?.map((condition) => <p><strong>Postcondition:</strong> {condition}</p>)}
          {overlay?.invariants?.map((invariant) => <p><strong>Invariant:</strong> {invariant}</p>)}
          {overlay?.failureSemantics?.map((failure) => <p><strong>Failure semantic:</strong> {failure}</p>)}
          {overlay?.errors?.map((error) => <p><strong>Error:</strong> {error}</p>)}
          {overlay?.sideEffects?.map((effect) => <p><strong>Side effect:</strong> {effect}</p>)}
          {overlay?.permissions && <p><strong>Permissions:</strong> {overlay.permissions}</p>}
          {overlay?.undo && <p><strong>Undo:</strong> {overlay.undo}</p>}
        </>
      : <p class="source-undocumented">No reviewed contract or source description is recorded.</p>}

    {visibleCalls.length > 0 && (
      <p class="source-call-list">
        <strong>Direct calls in this module:</strong>{' '}
        {visibleCalls.map((call, index) => <>{index > 0 && ', '}<code>{call}</code></>)}
        {calls.length > visibleCalls.length && `, and ${calls.length - visibleCalls.length} more`}
      </p>
    )}
    {visibleCallers.length > 0 && (
      <p class="source-call-list">
        <strong>Referenced by in this module:</strong>{' '}
        {visibleCallers.map((caller, index) => <>{index > 0 && ', '}<code>{caller}</code></>)}
        {callers.length > visibleCallers.length && `, and ${callers.length - visibleCallers.length} more`}
      </p>
    )}
  </div>
</details>
